    "turns": ["no, I can't make it"],
    "expect": {"reply_contains": ["RESCHEDULE"]}
  },
  {
    "id": "rem_reschedule_after_reminder",
    "category": "reminder",
    "description": "Wants a new time. Changing an appointment still requires identity verification",
    "setup": {
      "bookings": [{"patient": "taylor", "provider": "therapy", "slot": 0}],
      "reminder_for": {"patient": "taylor", "provider": "therapy", "slot": 0}
